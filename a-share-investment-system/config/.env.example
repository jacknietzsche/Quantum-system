# ═══════════════════════════════════════════════════════
#  A股智能投资系统 — 环境变量模板
#  复制为 .env 并填入实际值
#  .env 已在 .gitignore 中，不会被提交
# ═══════════════════════════════════════════════════════

# ── LLM API Keys ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

CHATANYWHERE_API_KEY=sk-your-chatanywhere-key
CHATANYWHERE_BASE_URL=https://api.chatanywhere.com.cn/v1

JUGUANG_API_KEY=sk-your-juguang-key
JUGUANG_BASE_URL=https://ai.juguang.chat/v1

CHERRYIN_API_KEY=sk-your-cherryin-key
CHERRYIN_BASE_URL=https://open.cherryin.net/v1

TICKFLOW_API_KEY=tk-your-tickflow-key

# ── QQ 邮箱 ──
QQ_EMAIL_SENDER=your-email@qq.com
QQ_EMAIL_AUTH_CODE=your-auth-code
QQ_EMAIL_RECEIVERS=receiver1@qq.com,receiver2@qq.com

# ── 数据源 ──
# TICKFLOW_TOKEN=tk-your-tickflow-token
TUSHARE_TOKEN=your-tushare-token
