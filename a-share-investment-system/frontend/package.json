{
  "name": "ashare-investment-frontend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --skipLibCheck && vite build",
    "build:quick": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --skipLibCheck --noEmit",
    "test": "vitest run",
