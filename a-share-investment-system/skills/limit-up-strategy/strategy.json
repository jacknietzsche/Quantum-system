{
  "name": "limit-up-strategy",
  "version": "1.0",
  "description": "涨停板策略 — 追涨停/打板",
  "category": "limit_up",
  "selection": {
    "min_change_pct": 9.5,
    "max_change_pct": 10.5,
    "min_volume_ratio": 1.5,
    "custom_filters": [
      {"field": "market_cap", "operator": ">", "value": 50},
      {"field": "listing_days", "operator": ">", "value": 60}
    ]
  },
  "scoring": {
    "weights": {
      "volume_ratio": 0.25,
      "momentum_5d": 0.20,
      "turnover_rate": 0.20,
      "limit_up_count": 0.20,
      "market_cap": 0.15
    },
    "base_score": 40,
    "max_score": 100
  },
  "risk": {
    "stop_loss_pct": -5,
    "take_profit_pct": 20,
    "max_position_pct": 10,
    "max_holdings": 5,
    "trailing_stop": false
  }
}
