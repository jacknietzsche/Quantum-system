{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Strategy Definition",
  "description": "定义技能的可执行选股条件、评分权重和风控规则",
  "type": "object",
  "required": ["name", "version", "selection", "scoring", "risk"],
  "properties": {
    "name": {
      "type": "string",
      "description": "策略名称"
    },
    "version": {
      "type": "string",
      "description": "策略版本"
    },
    "description": {
      "type": "string",
      "description": "策略描述"
    },
    "category": {
      "type": "string",
      "enum": ["value", "momentum", "limit_up", "hybrid", "trend", "contrarian"],
      "description": "策略类别"
    },
    "selection": {
      "type": "object",
      "description": "选股条件 (硬过滤)",
      "properties": {
        "min_roe": { "type": "number", "description": "最低ROE(%)" },
        "max_pe": { "type": "number", "description": "最高PE" },
        "max_pb": { "type": "number", "description": "最高PB" },
        "min_market_cap": { "type": "number", "description": "最低市值(亿)" },
        "min_volume_ratio": { "type": "number", "description": "最低量比" },
        "min_change_pct": { "type": "number", "description": "最低涨跌幅(%)" },
        "max_change_pct": { "type": "number", "description": "最高涨跌幅(%)" },
        "required_trend": { "type": "string", "description": "要求趋势 (bullish/bearish/neutral)" },
        "custom_filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "operator": { "type": "string", "enum": [">", "<", ">=", "<=", "==", "!="] },
              "value": {}
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "description": "评分权重 (软排序)",
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "因子名→权重映射, 如 {\"momentum_20d\": 0.3, \"roe\": 0.2}"
        },
        "base_score": { "type": "number", "description": "基础分" },
        "max_score": { "type": "number", "description": "最高分" }
      }
    },
    "risk": {
      "type": "object",
      "description": "风控规则",
      "properties": {
        "stop_loss_pct": { "type": "number", "description": "止损线(%)" },
        "take_profit_pct": { "type": "number", "description": "止盈线(%)" },
        "max_position_pct": { "type": "number", "description": "单只最大仓位(%)" },
        "max_holdings": { "type": "integer", "description": "最大持仓数" },
        "trailing_stop": { "type": "boolean", "description": "是否启用移动止损" },
        "atr_stop_multiplier": { "type": "number", "description": "ATR止损倍数" }
      }
    }
  }
}
