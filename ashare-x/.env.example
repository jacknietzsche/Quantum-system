# AShare-X 环境变量模板
# 复制为 .env 并填入真实值。.env 永不提交（见 .gitignore）。

# ── LLM (DeepSeek, 主选) ──
# 获取: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── LLM 备选 (DashScope / 智谱, 异质模型防同质化, 见 S04) ──
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=

# ── 预算 (RMB 月成本口径, 见 IMPLEMENTATION_PLAN §0.1, exp14 实测) ──
# 默认 ¥100/月, 用量达 100% 自动降级快速模式, 120% 暂停非紧急任务
ASHARE_X_MONTHLY_BUDGET_RMB=100

# ── 日志语言 (zh / en) ──
ASHARE_X_LANG=zh
